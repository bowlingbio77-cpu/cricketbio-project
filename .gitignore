# Virtual environments
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# Downloaded model weights (committed so Video Motion Capture works on
# Streamlit Cloud without a runtime download step)
!models/pose_landmarker_heavy.task
!yolo11n.pt

# Trained model bundles ARE committed (retrain with train_demo_model.py)
!models/*.joblib

# User-local runtime data (history DB regenerated automatically -- not committed)
data/*
!data/synthetic_bowling_dataset.csv
!data/cricket_injury_recovery_benchmarks.json
!data/cricket_injury_recovery_benchmarks.csv

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# CatBoost training temp output
catboost_info/
