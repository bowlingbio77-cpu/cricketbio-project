# Virtual environments
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Downloaded model weights (committed so Video Motion Capture works on
# Streamlit Cloud without a runtime download step). The YOLO weights live in
# models/ (see src/config.py: YOLO_WEIGHTS = models/yolo11n.pt).
!models/pose_landmarker_heavy.task
!models/yolo11n.pt

# Trained model bundles ARE committed (retrain with scripts/train_demo_model.py)
!models/*.joblib

# User-local runtime data (history DB regenerated automatically -- not committed)
data/*
!data/synthetic_bowling_dataset.csv
!data/cricket_injury_recovery_benchmarks.json
!data/cricket_injury_recovery_benchmarks.csv
!data/multimodal_sports_injury_dataset.csv
!data/cricket_injury_dataset.csv

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# CatBoost training temp output
catboost_info/

# Local dev server logs (streamlit stdout/stderr captures)
*.log

# Raw bowling videos for ball-tracker labeling/eval (large, not committed)
corrected_all_data/

# YOLO training run outputs (large, regenerated by scripts)
runs/

# Local test asset (binary)
test_synthetic.mp4

# Evaluation dataset (large, downloaded separately)
evaluation/single_video_benchmark/dataset/
